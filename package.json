{
  "name": "rock-calculator",
  "version": "1.6.10",
  "description": "内置完整赛季数据、可断网使用的洛克王国 PVP 伤害计算器。",
  "author": "洛克计算器",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Evenstar-tools/roco-calculator.git"
  },
  "bugs": {
    "url": "https://github.com/Evenstar-tools/roco-calculator/issues"
  },
  "homepage": "https://github.com/Evenstar-tools/roco-calculator#readme",
  "private": true,
  "type": "module",
  "main": "desktop/main.mjs",
  "bin": {
    "rock-calculator": "./scripts/cli/rock-calculator.mjs"
  },
  "scripts": {
    "cli": "node scripts/cli/rock-calculator.mjs",
    "cli:test": "vitest run tests/cli/rock-calculator-cli.test.js",
    "dev": "npm run data:runtime && vite --config config/vite.config.mjs",
    "build": "npm run acceptance:verify && npm run test:core-current && npm run data:runtime && npm run data:verify-bindings && vite build --config config/vite.config.mjs && npm run performance:verify",
    "desktop": "npm run build && electron .",
    "desktop:pack": "npm run build && node scripts/build-desktop.mjs",
    "desktop:release-assets": "node scripts/create-desktop-release-artifacts.mjs",
    "preview": "vite preview --config config/vite.config.mjs",
    "preview:test": "vite preview --config config/vite.config.mjs --host 127.0.0.1 --port 4174 --strictPort",
    "pretest": "npm run test:core-current",
    "test": "vitest run --config config/vite.config.mjs",
    "test:watch": "vitest --config config/vite.config.mjs",
    "acceptance:verify": "node scripts/verify-acceptance.mjs",
    "performance:verify": "node scripts/verify-performance-budget.mjs",
    "miniapp:sync-core": "node scripts/miniapp/sync-core.mjs",
    "test:core-drift": "node scripts/miniapp/check-core-drift.mjs",
    "test:core-current": "node scripts/miniapp/check-core-drift.mjs --current-only",
    "miniapp:test": "npm run test:core-current && npm --prefix miniapp test -- --run",
    "miniapp:build": "npm run miniapp:sync-core && npm run test:core-drift && npm --prefix miniapp run build:weapp -- --mode development",
    "miniapp:build:prod": "node scripts/miniapp/verify-release.mjs --preflight && npm run data:verify-bindings && npm run miniapp:sync-core && npm run test:core-drift && npm --prefix miniapp run build:weapp -- --mode production && node scripts/miniapp/verify-release.mjs",
    "miniapp:portrait-probe": "node scripts/miniapp/verify-portrait-layout.mjs",
    "lint": "eslint .",
    "e2e": "playwright test --config config/playwright.config.js",
    "data:build": "node scripts/bwiki/build-snapshot.mjs",
    "data:check-updates": "node scripts/bwiki/check-source-updates.mjs",
    "data:audit-form-roles": "node scripts/audit-form-role-manifest.mjs",
    "data:runtime": "node scripts/runtime-snapshot.mjs data/snapshots/current.json public/data/runtime.json public/assets/spirits/manifest.json",
    "data:verify-bindings": "node scripts/bwiki/verify-spirit-bindings.mjs",
    "data:validate": "node scripts/bwiki/validate.mjs data/snapshots/current.json"
  },
  "dependencies": {
    "@phosphor-icons/react": "2.1.10",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@babel/parser": "7.29.7",
    "@babel/traverse": "8.0.4",
    "@playwright/test": "1.62.1",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.6",
    "@vitejs/plugin-react": "6.1.1",
    "cheerio": "1.2.0",
    "electron": "44.1.0",
    "electron-builder": "^26.15.3",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.11.0",
    "jimp": "^1.6.1",
    "jsdom": "26.1.0",
    "miniprogram-automator": "0.12.1",
    "pinyin-pro": "3.28.2",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  },
  "overrides": {
    "fast-uri": "3.1.5",
    "undici": "7.29.0"
  },
  "build": {
    "appId": "cn.rock.calculator",
    "productName": "洛克计算器",
    "artifactName": "洛克计算器-${version}.${ext}",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "desktop/**/*",
      "package.json",
      "!node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "dist/client",
        "to": "client"
      }
    ],
    "win": {
      "icon": "desktop/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "guid": "5ca658da-1ce6-5199-babe-3d59475e8d1a",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "洛克计算器",
      "uninstallDisplayName": "洛克计算器"
    }
  }
}
