{
  "apis": [
    {
      "name": "searchRocoData",
      "description": "从小程序内置国服资料查询精灵、技能或特性。计算前用真实ID确认完整形态与技能。kind=skill时可用spiritId限定可学技能，并返回技能条件控件，供后续计算填写。多候选需用户确认，不自动选首项。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "minLength": 1,
            "description": "精灵、技能或特性的名字、关键词或ID。"
          },
          "kind": {
            "type": "string",
            "enum": [
              "spirit",
              "skill",
              "trait"
            ],
            "default": "spirit",
            "description": "查询类别，默认精灵。"
          },
          "spiritId": {
            "type": "string",
            "description": "查询技能时可选，使用已查询到的精灵ID限定学习面。"
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 12,
            "default": 8
          }
        },
        "required": [
          "query"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "error"
            ]
          },
          "kind": {
            "type": "string"
          },
          "query": {
            "type": "string"
          },
          "total": {
            "type": "integer"
          },
          "truncated": {
            "type": "boolean"
          },
          "results": {
            "type": "array",
            "items": {
              "$ref": "#/definitions/searchResult"
            }
          },
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "definitions": {
          "scalar": {
            "type": [
              "string",
              "number",
              "boolean",
              "null"
            ]
          },
          "identity": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "name"
            ]
          },
          "stats": {
            "type": "object",
            "properties": {
              "hp": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "speed": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "physicalAttack": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "magicalAttack": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "physicalDefense": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "magicalDefense": {
                "type": [
                  "number",
                  "null"
                ]
              }
            }
          },
          "option": {
            "anyOf": [
              {
                "$ref": "#/definitions/scalar"
              },
              {
                "type": "object",
                "properties": {
                  "label": {
                    "type": "string"
                  },
                  "value": {
                    "$ref": "#/definitions/scalar"
                  }
                },
                "required": [
                  "label",
                  "value"
                ]
              }
            ]
          },
          "visibleWhen": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "contextKey": {
                "type": "string"
              },
              "defaultValue": {
                "$ref": "#/definitions/scalar"
              },
              "equals": {
                "$ref": "#/definitions/scalar"
              }
            }
          },
          "control": {
            "type": "object",
            "properties": {
              "parameter": {
                "type": "string"
              },
              "id": {
                "type": "string"
              },
              "contextKey": {
                "type": "string"
              },
              "label": {
                "type": "string"
              },
              "type": {
                "type": "string"
              },
              "min": {
                "type": "number"
              },
              "max": {
                "type": "number"
              },
              "step": {
                "type": "number"
              },
              "defaultValue": {
                "$ref": "#/definitions/scalar"
              },
              "options": {
                "type": "array",
                "items": {
                  "$ref": "#/definitions/option"
                }
              },
              "visibleWhen": {
                "$ref": "#/definitions/visibleWhen"
              }
            }
          },
          "trait": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "description": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "name"
            ]
          },
          "searchResult": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "description": {
                "type": "string"
              },
              "types": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "raceStats": {
                "$ref": "#/definitions/stats"
              },
              "calculationStatus": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "traits": {
                "type": "array",
                "items": {
                  "$ref": "#/definitions/trait"
                }
              },
              "defaultLevel": {
                "type": "integer"
              },
              "type": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "category": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "basePower": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "cost": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "controls": {
                "type": "array",
                "items": {
                  "$ref": "#/definitions/control"
                }
              }
            },
            "required": [
              "id",
              "name"
            ]
          }
        }
      }
    },
    {
      "name": "calculateRocoDamage",
      "description": "复用小程序确定性计算核心，计算一次技能使用的实际伤害、多段分布、最大生命占比与目标剩余生命。只读，不执行攻击、不改保存配置。攻守方及技能使用真实ID或完整唯一名称；遵守当前国服等级与学习面。缺少必要条件或规则未支持时返回明确原因，不猜数值。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "attacker": {
            "type": "string",
            "description": "攻击方精灵ID或完整唯一形态名称。"
          },
          "defender": {
            "type": "string",
            "description": "防御方精灵ID或完整唯一形态名称。"
          },
          "skill": {
            "type": "string",
            "description": "攻击方可学技能的ID或完整唯一名称。"
          },
          "attackerNature": {
            "type": "string",
            "description": "可选，攻击方性格名称或ID；未填沿用普通性格并说明假设。"
          },
          "defenderNature": {
            "type": "string",
            "description": "可选，防御方性格名称或ID。"
          },
          "attackerLevel": {
            "type": "integer",
            "minimum": 1,
            "maximum": 99,
            "description": "普通精灵固定60级，支持等级调整的特殊精灵默认99级。"
          },
          "defenderLevel": {
            "type": "integer",
            "minimum": 1,
            "maximum": 99
          },
          "attackerHpPercent": {
            "type": "number",
            "minimum": 0,
            "maximum": 100,
            "default": 100,
            "description": "攻击方自身当前生命百分比。"
          },
          "defenderHpPercent": {
            "type": "number",
            "minimum": 0,
            "maximum": 100,
            "default": 100,
            "description": "目标当前生命百分比。"
          },
          "attackStage": {
            "type": "integer",
            "minimum": -99,
            "maximum": 99,
            "default": 0,
            "description": "攻击方当前攻击能力等级，与首页等级范围一致。"
          },
          "defenseStage": {
            "type": "integer",
            "minimum": -99,
            "maximum": 99,
            "default": 0,
            "description": "防御方当前防御能力等级，与首页等级范围一致。"
          },
          "skillValues": {
            "type": "object",
            "description": "仅填写searchRocoData返回的当前技能真实控件key与合法值；无依据时不擅自触发。"
          }
        },
        "required": [
          "attacker",
          "defender",
          "skill"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "exact",
              "error"
            ]
          },
          "attacker": {
            "$ref": "#/definitions/identity"
          },
          "defender": {
            "$ref": "#/definitions/identity"
          },
          "skill": {
            "$ref": "#/definitions/identity"
          },
