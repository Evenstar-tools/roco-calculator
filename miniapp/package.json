{
  "name": "rock-calculator-miniapp",
  "private": true,
  "version": "1.1.7",
  "scripts": {
    "build:h5": "node --no-deprecation ./scripts/run-taro.cjs build --type h5",
    "build:weapp": "node --no-deprecation ./scripts/run-taro.cjs build --type weapp",
    "dev:h5": "node --no-deprecation ./scripts/run-taro.cjs build --type h5 --watch",
    "prebuild:h5": "node ../scripts/miniapp/build-bundled-runtime.mjs && node ../scripts/miniapp/sync-core.mjs",
    "prebuild:weapp": "node ../scripts/miniapp/build-bundled-runtime.mjs && node ../scripts/miniapp/sync-core.mjs",
    "postbuild:weapp": "node ../scripts/miniapp/minify-weapp-assets.mjs",
    "predev:h5": "node ../scripts/miniapp/build-bundled-runtime.mjs && node ../scripts/miniapp/sync-core.mjs",
    "sync:core": "node ../scripts/miniapp/sync-core.mjs",
    "test": "vitest"
  },
  "dependencies": {
    "@tarojs/components": "4.2.1",
    "@tarojs/helper": "4.2.1",
    "@tarojs/plugin-framework-react": "4.2.1",
    "@tarojs/plugin-platform-h5": "4.2.1",
    "@tarojs/plugin-platform-weapp": "4.2.1",
    "@tarojs/react": "4.2.1",
    "@tarojs/runtime": "4.2.1",
    "@tarojs/shared": "4.2.1",
    "@tarojs/taro": "4.2.1",
    "lz-string": "^1.5.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@babel/plugin-proposal-decorators": "7.25.9",
    "@babel/plugin-transform-class-properties": "7.25.9",
    "@tarojs/cli": "4.2.1",
    "@tarojs/vite-runner": "4.2.1",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.3.2",
    "@vitejs/plugin-react": "4.3.4",
    "clean-css": "4.2.4",
    "jsdom": "26.1.0",
    "terser": "5.49.0",
    "vite": "4.5.14",
    "vitest": "3.2.7"
  }
}
